# Production environment template — COPY to `.env.production` (0600, NEVER in Git).
# Every value below is a placeholder. Production secrets are entered on the
# VPS / CI only. Confirm CONFIGURED vs MISSING with the health-check script.

APP_ENV=production
APP_NAME=Prime Nest Business Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Neon (pooled runtime; direct endpoint for migrations when needed) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLED-HOST:5432/DB?sslmode=require
PLATFORM_DATABASE_URL=
PRIME_DATABASE_URL=
NEST_DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Auth (generate fresh, per-environment) ---
SECRET_KEY=CHANGE-ME
JWT_SECRET_KEY=CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# --- CORS: exact production origins, never "*" ---
BACKEND_CORS_ORIGINS=https://prime-fitness.pages.dev,https://nest-library.pages.dev,https://prime-fitness-staff.pages.dev,https://nest-library-staff.pages.dev,https://prime-nest-owner.pages.dev
PUBLIC_SITE_ORIGINS=https://prime-fitness.pages.dev,https://nest-library.pages.dev

# --- VPS Redis (private to the VPS compose network) ---
REDIS_URL=redis://redis:6379/0

# --- Rate limits / body guard ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_REQUESTS=20
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=600
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
MAX_BODY_BYTES=65536

# --- Identity seeds (canonical owner/staff; passwords via secrets manager) ---
OWNER_SEED_EMAIL=owner@prime-nest-dashboard.com
OWNER_SEED_PASSWORD=CHANGE-ME
SEED_PLATFORM_OWNER=true
STAFF_SEED_PASSWORD=CHANGE-ME
SEED_DEV_STAFF=true

# --- AI (off until a real key is provisioned) ---
AI_ENABLED=false
AI_PROVIDER=noop
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- WhatsApp (mock-safe until Meta production credentials are provisioned) ---
PRIME_WHATSAPP_ENABLED=false
PRIME_WHATSAPP_ACCESS_TOKEN=
PRIME_WHATSAPP_PHONE_NUMBER_ID=
PRIME_WHATSAPP_BUSINESS_ACCOUNT_ID=
PRIME_WHATSAPP_VERIFY_TOKEN=
PRIME_WHATSAPP_APP_SECRET=
NEST_WHATSAPP_ENABLED=false
NEST_WHATSAPP_ACCESS_TOKEN=
NEST_WHATSAPP_PHONE_NUMBER_ID=
NEST_WHATSAPP_BUSINESS_ACCOUNT_ID=
NEST_WHATSAPP_VERIFY_TOKEN=
NEST_WHATSAPP_APP_SECRET=

# --- Payments (deterministic/test-safe until Razorpay live keys exist) ---
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Automation / worker / scheduler ---
AUTOMATION_ENABLED=true
AUTOMATION_MAX_ATTEMPTS=5
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_LEASE_SECONDS=120
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=15
WORKER_BATCH_SIZE=50

# --- Cloudflare (Worker secrets, set via `wrangler secret put`) ---
UPSTREAM_BACKEND_URL=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
TUNNEL_TOKEN=
