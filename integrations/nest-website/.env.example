# Nest Library website — public, non-secret configuration.
# Copy to .env for local development. NEVER put secrets in VITE_ variables
# (they are embedded in the browser bundle).

# Shared FastAPI backend base URL (no trailing slash).
# Local backend: http://localhost:8000
# Leave empty to run the site without backend submission.
VITE_API_BASE_URL=http://localhost:8000

# Business slug addressed by public intake endpoints (backend-verified).
VITE_BUSINESS_SLUG=nest
