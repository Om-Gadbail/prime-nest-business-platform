# Staff dashboard — staff-only configuration (no secrets here).
# Copy to .env for local development.

# Shared FastAPI backend base URL (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Default business for the login screen branding + business_slug hint.
# Users with several memberships can switch after login.
VITE_BUSINESS_SLUG=prime

# Optional display name override (defaults come from the backend business).
VITE_BUSINESS_NAME=
