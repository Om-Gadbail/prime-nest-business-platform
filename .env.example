# =============================================================================
# Prime Fitness x Nest Library Business Platform — environment template
# NEVER commit a real .env with real secrets. Copy to .env, then fill in.
#   cp .env.example .env
# Sections: shared defaults → Development → Testing → Staging → Production.
# Frontend (Vite) reads ONLY VITE_* vars (see apps/staff-dashboard/.env.example
# and integrations/nest-website/.env.example). NEVER put GEMINI_*/WHATSAPP_*
# secrets in any VITE_* variable — they ship to browsers.
# =============================================================================

# --- Shared defaults (all environments; override per section below) ---
APP_NAME=Prime Nest Business Platform
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database (PostgreSQL via Docker network) ---
# Local/dev example. NEVER commit a real .env with real secrets.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app_db

# --- Prompt 2: multi-business database targets ---
# Empty (default) = co-located mode: platform_db / prime_db / nest_db all
# share DATABASE_URL (one physical database, row-level tenant isolation).
# Set distinct URLs to cut over to physically separate databases — no code
# changes needed. See docs/database-migration-report.md before splitting.
# These are SERVER configuration; no request/job/header may select a database.
PLATFORM_DATABASE_URL=
PRIME_DATABASE_URL=
NEST_DATABASE_URL=

# --- Prompt 2: unified platform owner seed (development/demo) ---
# The single canonical owner identity (platform identity layer, memberships
# to Prime + Nest). Plaintext here is a DEMO credential for non-production
# only; production REFUSES the demo default — set a strong value.
OWNER_SEED_EMAIL=owner@prime-nest-dashboard.com
OWNER_SEED_PASSWORD=OwnerDemo123!
SEED_PLATFORM_OWNER=true

# --- Docker Compose Postgres settings ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5433
BACKEND_PORT=8000

# --- Redis (job coordination, distributed rate limiting, future cache) ---
# Empty = single-process fallback (in-memory limiter, DB polling). Docker sets
# redis://redis:6379/0 automatically via compose; local non-Docker dev can run
# `docker run -p 6379:6379 redis:7-alpine` and set REDIS_URL=redis://localhost:6379/0.
REDIS_URL=
REDIS_PORT=6379

# --- CORS (comma-separated exact origins, never "*") ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public website + staff dashboard origins (unioned into CORS; owner-configurable, no default).
# 5173 = website Vite dev default; 5174 = staff dashboard Vite dev (see apps/staff-dashboard).
PUBLIC_SITE_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Block 2: rate limiting (in-process dev limiter) ---
# Production with multiple workers/replicas MUST set REDIS_URL (see docs/BLOCK2.md).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_REQUESTS=20
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=600
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# --- Block 2: API payload limits ---
# Pre-parse Content-Length cap enforced by middleware on ALL endpoints.
MAX_BODY_BYTES=65536

# --- Block 2: AI foundation (disabled by default; backend env only) ---
AI_ENABLED=false
AI_PROVIDER=noop
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=8000

# --- Blocks 8-12: Gemini AI gateway (Block 10) ---
# Get a key at https://aistudio.google.com/apikey — paste here, never commit.
# Model: current stable Flash-class (low-latency conversational/agentic).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_TOOL_CALLS=6
AI_PUBLIC_CHAT_ENABLED=true
AI_PUBLIC_RATE_REQUESTS=10
AI_PUBLIC_RATE_WINDOW_SECONDS=600

# --- Blocks 8-12: WhatsApp Cloud API (Block 9; all optional in demo) ---
# Meta dashboard: https://developers.facebook.com/apps — WhatsApp > API Setup.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Multi-number routing "slug:phone_id,slug:phone_id" (e.g. "prime:123,nest:456").
# Wins over the single WHATSAPP_PHONE_NUMBER_ID fallback; per-business
# business_settings.operational.whatsapp.phone_number_id wins over both.
WHATSAPP_PHONE_NUMBER_MAP=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Blocks 8-12: automation scheduler (Block 8) ---
AUTOMATION_ENABLED=true
AUTOMATION_MAX_ATTEMPTS=5

# --- Full-platform integration: scheduler + worker ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_LEASE_SECONDS=120
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=15
WORKER_BATCH_SIZE=50

# --- Secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required to be non-default when APP_ENV=production.
SECRET_KEY=change-me-in-production

# --- Auth / JWT (Block 1) ---
# JWT_SECRET_KEY overrides SECRET_KEY for token signing when set.
# Either SECRET_KEY or JWT_SECRET_KEY must be strong in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Payment provider webhooks (Prompt 5): HMAC secret for POST /api/v1/payments/webhook.
# Empty = webhooks rejected with 503 (never accept unverified money movement).
# Local/test only: PAYMENT_WEBHOOK_SECRET=test-secret (clearly labelled TEST).
PAYMENT_WEBHOOK_SECRET=
# Browser cookie flags for the refresh-token HttpOnly cookie.
# Local dev over http: AUTH_COOKIE_SECURE=false. Production https: true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# =============================================================================
# Development (default: APP_ENV=development)
#   cp .env.example .env
#   docker compose up --build
# - Providers OFF (AI_PROVIDER=noop, WHATSAPP_ENABLED=false) so every flow is
#   testable with the fake providers. No real keys needed.
# - Docs enabled at /docs. AUTH_COOKIE_SECURE=false over http.
# =============================================================================
# APP_ENV=development

# =============================================================================
# Testing (backend pytest uses SQLite; APP_ENV=testing)
#   cd backend; pytest
# - No Docker needed. Tests create their own users/businesses; seed is
#   idempotent. REDIS_URL stays empty (in-memory limiter under test).
# =============================================================================
# APP_ENV=testing

# =============================================================================
# Staging (mirror of production config, non-prod data + test credentials)
# - Set APP_ENV=staging (treated as non-production: docs on, demo fallbacks
#   allowed), strong SECRET_KEY, staging DATABASE_URL + REDIS_URL, staging
#   WHATSAPP_* (sandbox numbers), AI_PROVIDER=gemini + staging GEMINI_API_KEY
#   to exercise the real path without touching production data.
# =============================================================================
# APP_ENV=staging
# SECRET_KEY=<staging-secret-48-chars>
# DATABASE_URL=postgresql+psycopg://<user>:<pass>@<staging-host>:5432/<db>
# REDIS_URL=redis://<staging-host>:6379/0
# BACKEND_CORS_ORIGINS=https://staging-dashboard.example.com
# PUBLIC_SITE_ORIGINS=https://staging-prime.example.com,https://staging-nest.example.com
# AUTH_COOKIE_SECURE=true

# =============================================================================
# Production (DO NOT deploy per mission rule; when authorized:)
# - APP_ENV=production disables /docs, fails fast on weak SECRET_KEY, and
#   fail-closes WhatsApp webhooks without WHATSAPP_APP_SECRET.
# - REQUIRED: strong SECRET_KEY (or JWT_SECRET_KEY), managed DATABASE_URL,
#   REDIS_URL, exact BACKEND_CORS_ORIGINS + PUBLIC_SITE_ORIGINS, real
#   GEMINI_API_KEY (AI_PROVIDER=gemini) or AI_ENABLED=false for honest
#   fallback, real WHATSAPP_* (or WHATSAPP_ENABLED=false for log fallback),
#   AUTH_COOKIE_SECURE=true, scheduler/worker replicas behind the Redis lease.
# =============================================================================
# APP_ENV=production
# SECRET_KEY=<prod-secret-48-chars>
# JWT_SECRET_KEY=<prod-jwt-secret-48-chars>
# DATABASE_URL=postgresql+psycopg://<user>:<pass>@<prod-host>:5432/<db>
# REDIS_URL=redis://<prod-host>:6379/0
# BACKEND_CORS_ORIGINS=https://dashboard.example.com
# PUBLIC_SITE_ORIGINS=https://prime.example.com,https://nest.example.com
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# AI_PROVIDER=gemini
# GEMINI_API_KEY=<prod-gemini-key>
# WHATSAPP_ENABLED=true
# WHATSAPP_ACCESS_TOKEN=<prod-token>
# WHATSAPP_PHONE_NUMBER_MAP=prime:<prime-phone-id>,nest:<nest-phone-id>
# WHATSAPP_VERIFY_TOKEN=<prod-verify-token>
# WHATSAPP_APP_SECRET=<prod-app-secret>
